<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_banner"
            android:layout_marginBottom="12dp" />

        <!-- Grille du jour -->
        <LinearLayout style="@style/Carte">

            <TextView
                style="@style/TitreCarte"
                android:text="@string/titre_pronostic" />

            <TextView
                android:id="@+id/tvDate"
                style="@style/TexteDoux"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/boule1" style="@style/Boule" />
                <TextView android:id="@+id/boule2" style="@style/Boule" />
                <TextView android:id="@+id/boule3" style="@style/Boule" />
                <TextView android:id="@+id/boule4" style="@style/Boule" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetails"
                style="@style/TexteDoux"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvConseilPari"
                style="@style/TexteDoux"
                android:layout_marginTop="10dp"
                android:textColor="@color/glacier" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecalculer"
                style="@style/BoutonContour"
                android:layout_marginTop="10dp"
                android:text="@string/bouton_recalculer" />
        </LinearLayout>

        <!-- Avertissement scientifique -->
        <LinearLayout style="@style/Carte">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/avertissement"
                android:textColor="@color/alerte"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Réglages du modèle -->
        <LinearLayout style="@style/Carte">

            <TextView
                style="@style/TitreCarte"
                android:text="@string/titre_modele" />

            <TextView
                android:id="@+id/tvChaud"
                style="@style/TexteDoux"
                android:textColor="@color/texte" />

            <SeekBar
                android:id="@+id/seekChaud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:max="100" />

            <TextView
                android:id="@+id/tvRetard"
                style="@style/TexteDoux"
                android:textColor="@color/texte" />

            <SeekBar
                android:id="@+id/seekRetard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:max="100" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEquilibre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_equilibre"
                android:textColor="@color/texte" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchBiais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_biais"
                android:textColor="@color/texte" />

            <TextView
                android:id="@+id/tvInfoModele"
                style="@style/TexteDoux"
                android:layout_marginTop="6dp"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Ajout de résultats -->
        <LinearLayout style="@style/Carte">

            <TextView
                style="@style/TitreCarte"
                android:text="@string/titre_ajout" />

            <TextView
                android:id="@+id/tvHistorique"
                style="@style/TexteDoux"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNouveauTirage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/violet"
                android:gravity="top|start"
                android:hint="@string/hint_tirage"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="2"
                android:textColor="@color/texte"
                android:textColorHint="#6F7694"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAjouter"
                style="@style/BoutonPlein"
                android:layout_marginTop="8dp"
                android:text="@string/bouton_ajouter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnnulerDernier"
                    style="@style/BoutonContour"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/bouton_annuler_dernier" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExporter"
                    style="@style/BoutonContour"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/bouton_exporter" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImporter"
                style="@style/BoutonContour"
                android:text="@string/bouton_importer" />
        </LinearLayout>

        <!-- Notification -->
        <LinearLayout style="@style/Carte">

            <TextView
                style="@style/TitreCarte"
                android:text="@string/titre_notif" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_notif"
                android:textColor="@color/texte" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeure"
                style="@style/BoutonContour"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStats"
            style="@style/BoutonPlein"
            android:text="@string/bouton_stats" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDemo"
            style="@style/BoutonContour"
            android:layout_marginTop="6dp"
            android:text="@string/bouton_demo" />

    </LinearLayout>
</ScrollView>
