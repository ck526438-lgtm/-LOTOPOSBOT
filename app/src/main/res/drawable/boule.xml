<?xml version="1.0" encoding="utf-8"?>
<!-- Boule de verre irisée -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.35"
                android:centerY="0.3"
                android:gradientRadius="60%"
                android:startColor="#9C8BFF"
                android:centerColor="#4B3FA8"
                android:endColor="#1B1840" />
            <stroke android:width="1.5dp" android:color="#99C9D4FF" />
        </shape>
    </item>
</layer-list>
